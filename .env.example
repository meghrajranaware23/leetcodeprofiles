# ─── PayPal mode switch ───────────────────────────────────────────────────────
# sandbox | live — server picks credentials and plan IDs by mode
PAYPAL_MODE=sandbox

# ─── PayPal credentials (store BOTH pairs; server selects by PAYPAL_MODE) ────
PAYPAL_CLIENT_ID_SANDBOX=
PAYPAL_CLIENT_SECRET_SANDBOX=
PAYPAL_CLIENT_ID_LIVE=
PAYPAL_CLIENT_SECRET_LIVE=

# Legacy fallbacks (used if mode-specific vars are unset)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ─── PayPal webhook IDs (from PayPal Developer Dashboard per environment) ────
PAYPAL_WEBHOOK_ID_SANDBOX=
PAYPAL_WEBHOOK_ID_LIVE=

# ─── PayPal plan IDs (create via: PAYPAL_MODE=live npm run setup:paypal-plans)
PAYPAL_PLAN_MONTHLY_SANDBOX=
PAYPAL_PLAN_MONTHLY_LIVE=
PAYPAL_PLAN_YEARLY_SANDBOX=
PAYPAL_PLAN_YEARLY_LIVE=

# ─── Server (local dev) ───────────────────────────────────────────────────────
PORT=3001
FRONTEND_BASE_URL=http://localhost:5173
# On Render, RENDER_EXTERNAL_URL is set automatically — no need for API_BASE_URL
API_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173,https://leetcodeprofiles.com,https://www.leetcodeprofiles.com,https://leetcodeprofiles-ee772.web.app,https://leetcodeprofiles-ee772.firebaseapp.com

# Firebase Admin — local file path
FIREBASE_SERVICE_ACCOUNT_PATH=./server/secrets/firebase-admin.json
# Render: use FIREBASE_SERVICE_ACCOUNT_JSON (run npm run print:firebase-json)
# FIREBASE_SERVICE_ACCOUNT_JSON=

RECONCILE_JOB_SECRET=

# ─── Frontend (Vite — required for production Firebase Hosting + Render API) ──
# Leave empty for local dev (Vite proxies /api → localhost:3001)
# After Render deploy: VITE_API_URL=https://your-service.onrender.com
VITE_API_URL=
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_MODE=sandbox

# Full Render deploy guide: docs/render-deploy.md
